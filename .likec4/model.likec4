// Gamer — Architecture Model (v3)
// Module-level system model: elements, hierarchy, and relationships.
// See ARCHITECTURE.md for detailed technical decisions.

model {


  actor user {
    title 'User'
    description 'End user playing games via browser or native Moonlight client'
  }


  system gamerFrontend {
    title 'Gamer Frontend'
    description ''

    client gamerWebApp {
      title 'Gamer Web App'
      description ''
    }

    client gameriOSApp {
      title 'Gamer Mobile App'
      description ''
    }

    client gamerAndroidApp {
      title 'Gamer Android App'
      description ''
    }

  }


  system gamerBackend {
    title 'Gamer Backend'
    technology 'Python'
    description ''

    api gamerNodeAPI {
      title 'Gamer Node API'
      technology 'Python'
      description ''
    }

    api gamerClientAPI {
      title 'Gamer API'
      technology 'Python'
      description ''
    }

    api gamerLibraryAPI {
      title 'Gamer Library API'
      technology 'Python'
      description ''
    }

    api gamerAgentAPI {
      title 'Gamer Agent API'
      technology 'Python'
      description ''
    } 

    api gamerSessionAPI {
      title 'Gamer Session API'
      technology 'Python'
      description ''
    }

    api cloudSaveAPI {
      title 'Cloud Save API'
      technology 'Python'
      description ''

      route CloudSaveRoute {
        title 'Cloud Save Route'
        description ''
      }

      route CloudSaveAgentRoute {
        title 'Cloud Save Agent Route'
        description ''
      }
    }

  }


  system gamerNode {
    title 'Gamer Node'
    description ''

    service gamerTool {
      title 'Gamer Tool'
      technology 'Rust'
      description ''

      feature ZoomFeature {
        title 'Zoom'
        technology 'Rust'
        description ''
      }

      feature ShaderFeature {
        title 'Shader'
        technology 'Rust'
        description ''
      }

      feature HotkeysFeature {
        title 'Hotkeys'
        technology 'Rust'
        description ''
      }

      feature PerfomanceFeature {
        title 'Perfomance'
        technology 'Rust'
        description ''
      }

      feature TimeKeeperFeature {
        title 'Time Keeper'
        technology 'Rust'
        description ''
      }

    }

    service gamerAgent {
      title 'Gamer Agent'
      technology 'Rust'
      description ''

      agent OrchaestratorAgent {
        title 'Orchestrator'
        technology 'Rust'
        description ''
      }

      agent SaveManagerAgent {
        title 'Save Manager'
        technology 'Rust'
        description ''
      }

      agent GameSessionAgent {
        title 'Game Session'
        technology 'Rust'
        description ''

        route ShaderRoute {
          title 'Shader'
          description ''
        }

        route PerfomanceRoute {
          title 'Perfomance'
          description ''
        }

        route HotkeysRoute {
          title 'Hotkeys'
          description ''
        }

        route TimeKeeperRoute {
          title 'Time Keeper'
          description ''
        }
      }

      agent DeployerAgent {
        title 'Deployer'
        technology 'Rust'
        description ''
      }

    }

    service gamerSetupScripts {
      title 'Gamer Setup Scripts'
      description ''

      script WindowsSetupScript {
        title 'Windows Setup Script'
        technology 'PowerShell'
        description ''

        function DriverSetupFunction {
          title 'Driver Setup Function'
          description ''
        }

        function FileSystemSetupFunction {
          title 'File System Setup Function'
          description ''
        }

        function ApolloSetupFunction {
          title 'Apollo Setup Function'
          description ''
        }

        function SteamSetupFunction {
          title 'Steam Setup Function'
          description ''
        }

        function GamerAgentSetupFunction {
          title 'Gamer Agent Setup Function'
          description ''
        }
      }

      script LinuxSetupScript {
        title 'Linux Setup Script'
        technology 'Shell'
        description ''

        function DriverSetupFunction {
          title 'Driver Setup Function'
          description ''

        function FileSystemSetupFunction {
          title 'File System Setup Function'
          description ''
        }
        
        function SunshineSetupFunction {
          title 'Apollo Setup Function'
          description ''
        }

        function VirtualDisplaySetupFunction {
          title 'Virtual Display Setup Function'
          description ''
        }

        function SteamSetupFunction {
          title 'Steam Setup Function'
          description ''
        }

        function GamerAgentSetupFunction {
          title 'Gamer Agent Setup Function'
          description ''
        }
      }

    }

    }

  }


  storage gamerDatabase {
    title 'Gamer Database'
    description ''

    collection gamerGames {
      title 'Games'
      description ''
    }

    collection gamerUsers {
      title 'Users'
      description ''
    }

    collection gamerSessions {
      title 'Sessions'
      description ''
    }

    collection gamerSaves {
      title 'Saves'
      description ''
    }

    collection gamerNodes {
      title 'Nodes'
      description ''
    }

    collection gamerMetadata {
      title 'Metadata'
      description ''
    }

  }


}
