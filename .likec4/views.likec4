// Gamer — Architecture Views
// Organized into folders via '/' in titles.
// Static views for structure, dynamic views for flows.

views {

    view systemContext {
        title 'Context / System Context'
        description 'High-level view: user, platform, external services'

        include
            user,
            gamerFrontend.**,
            gamerBackend.**,
            gamerNode.**,
            gamerDatabase.**
    }

}