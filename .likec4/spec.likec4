// Gamer — Architecture Specification
// Defines element kinds, styles, and tags for the architecture model.

specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      color primary
    }
  }

  element script {
    style {
      color primary
    }
  }

  element client {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      color indigo
    }
  }

  element feature {
    style {
      color indigo
    }
  }

  element api {
    style {
      color blue
    }
  }

  element route {
    style {
      color blue
    }
  }

  element endpoint {
  }

  element page {
  }

  element vm {
    style {
      color muted
      shape rectangle
    }
  }

  element agent {
    style {
      color amber
      shape queue
    }
  }

  element database {
    style {
      shape storage
      color slate
    }
  }

  element collection {
    style {
      shape storage
      color slate
    }
  }

  element storage {
    style {
      shape storage
      color green
    }
  }

  element streamServer {
    style {
      color red
      shape rectangle
    }
  }

  element container {
    style {
      color secondary
      shape rectangle
    }
  }

  element function {
    style {
      shape rectangle
      color secondary
    }
  }

  element ext {
    style {
      color muted
    }
  }

  element pydanticModel {
    style {
      color sky
    }
  }

}
