
model {
    extend gamerFrontend {
        client WebApp {
            title 'Gamer Web App'
            description ''

            page LoginPage {
                title 'Login Page'
                description ''

                -> gamerBackend.ClientAPI.authentication
                -> gamerBackend.ClientAPI.authentication.google-login
                -> gamerBackend.ClientAPI.authentication.refresh
                -> gamerBackend.ClientAPI.authentication.logout
                -> gamerBackend.ClientAPI.authentication.logout-all
                -> gamerBackend.ClientAPI.authentication.me
            }

            page NodePage {
                title 'Node Page'
                description ''

                -> gamerBackend.ClientAPI.nodes
                -> gamerBackend.ClientAPI.nodes.list
                -> gamerBackend.ClientAPI.nodes.details
                -> gamerBackend.ClientAPI.nodes.start
                -> gamerBackend.ClientAPI.nodes.stop
                -> gamerBackend.ClientAPI.nodes.destroy
            }

            page CreateNodePage {
                title 'Add Node Page'
                description ''

                -> gamerBackend.ClientAPI.create-node
                -> gamerBackend.ClientAPI.create-node.list
                -> gamerBackend.ClientAPI.create-node.details
                -> gamerBackend.ClientAPI.create-node.create
                -> gamerBackend.ClientAPI.create-node.setup
                -> gamerBackend.ClientAPI.create-node.status
            }

            page LibraryPage {
                title 'Library Page'
                description ''

                -> gamerBackend.ClientAPI.library
                -> gamerBackend.ClientAPI.library.list
            }

            page AddGamePage {
                title 'Add Game Page'
                description ''

                -> gamerBackend.ClientAPI.library
                -> gamerBackend.ClientAPI.library.search-games
                -> gamerBackend.ClientAPI.library.add-game
            }

            page MetadataPage {
                title 'Metadata Page'
                description ''

                -> gamerBackend.ClientAPI.library
                -> gamerBackend.ClientAPI.library.find-metadata
                -> gamerBackend.ClientAPI.library.set-metadata
            }

            page GamePage {
                title 'Game Page'
                description ''

                -> gamerBackend.ClientAPI.library
                -> gamerBackend.ClientAPI.library.details
                -> gamerBackend.ClientAPI.library.delete
            }

            page SessionPage {
                title 'Session Page'
                description ''
            }
        }
    }
}