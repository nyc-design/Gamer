
model {
    extend gamerFrontend {
        client WebApp {
            title 'Gamer Web App'
            description ''

            page LoginPage {
                title 'Login Page'
                description ''

                -> gamerBackend.ClientAPI.authentication
            }

            page NodePage {
                title 'Node Page'
                description ''

                -> gamerBackend.ClientAPI.nodes
            }

            page CreateNodePage {
                title 'Add Node Page'
                description ''

                -> gamerBackend.ClientAPI.create-node
            }

            page LibraryPage {
                title 'Library Page'
                description ''

                -> gamerBackend.ClientAPI.library
            }

            page AddGamePage {
                title 'Add Game Page'
                description ''

                -> gamerBackend.ClientAPI.library
            }

            page MetadataPage {
                title 'Metadata Page'
                description ''

                -> gamerBackend.ClientAPI.library
            }

            page GamePage {
                title 'Game Page'
                description ''

                -> gamerBackend.ClientAPI.library
            }

            page SessionPage {
                title 'Session Page'
                description ''
            }
        }
    }
}